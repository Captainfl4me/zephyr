config MODEM_ST87_M01
	bool "ST87M01 modem driver"
	select MODEM_CONTEXT
	select MODEM_CMD_HANDLER
	select MODEM_IFACE_UART
	# select MODEM_SOCKET
	# select NET_OFFLOAD
	# select NET_SOCKETS_OFFLOAD
	help
	  Choose this setting to enable ST87M01 LTE-CatM1/NB-IoT modem driver.

if MODEM_ST87_M01
endif # MODEM_ST87_M01
